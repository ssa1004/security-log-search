{
  "annotations": { "list": [] },
  "description": "Flink correlation job 의 운영 메트릭 — records-in / records-out / backpressure / checkpoint duration. 알람 룰 평가 파이프라인 상태 확인. (ADR-0008, ADR-0009)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Flink job 의 task 별 records-in / records-out / 초. correlation rule 평가가 들어오는 만큼 나가는지 확인.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "records/s", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (task_name) (rate(flink_taskmanager_job_task_numRecordsInPerSecond[1m]))",
          "legendFormat": "in / {{task_name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (task_name) (rate(flink_taskmanager_job_task_numRecordsOutPerSecond[1m]))",
          "legendFormat": "out / {{task_name}}",
          "refId": "B"
        }
      ],
      "title": "Flink records — in / out (task 별)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Flink backpressure ratio — 0 = idle, 1 = 완전 backpressure. 0.5 이상 지속 시 downstream 정체 (CEP 평가 / Kafka producer 가 못 따라옴).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "ratio", "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (task_name) (flink_taskmanager_job_task_backPressuredTimeMsPerSecond / 1000)",
          "legendFormat": "{{task_name}}",
          "refId": "A"
        }
      ],
      "title": "Backpressure ratio (task 별)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Flink busy ratio — task 가 실제 record 처리에 쓴 시간 비율. backpressure 와 같이 보면 병목 위치 식별.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "ratio", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (task_name) (flink_taskmanager_job_task_busyTimeMsPerSecond / 1000)",
          "legendFormat": "{{task_name}}",
          "refId": "A"
        }
      ],
      "title": "Busy ratio (task 별)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "checkpoint duration — exactly-once 보장의 비용. 너무 커지면 (>30s) state 가 비대해진 신호.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "ms", "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 15000 },
              { "color": "red", "value": 30000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (job_name) (flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "{{job_name}} — last duration",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (job_name) (flink_jobmanager_job_lastCheckpointSize)",
          "legendFormat": "{{job_name}} — last size (bytes)",
          "refId": "B"
        }
      ],
      "title": "Checkpoint duration / size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "checkpoint 실패 카운터 — 0 이 아니면 즉시 조사. exactly-once 보장 실패의 근본 원인.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(flink_jobmanager_job_numberOfFailedCheckpoints)",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "title": "Checkpoint 실패 (전체)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Kafka consumer lag — Flink job 이 events.normalized 를 따라잡지 못하면 lag 가 커진다.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "messages", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (consumer_group, topic) (kafka_consumergroup_lag{topic=~\"events.normalized|alerts.fired\"})",
          "legendFormat": "{{topic}} / {{consumer_group}}",
          "refId": "A"
        }
      ],
      "title": "Kafka consumer lag (events.normalized / alerts.fired)",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["security-log-search", "flink", "streaming", "correlation"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Security Log Search — Flink Correlation",
  "uid": "sls-flink-correlation",
  "version": 1,
  "weekStart": ""
}
